# Copy to `.env.local` for development. Never commit a filled-in copy.
#
# None of this is required to start the app. With an empty file you get the
# landing page, the sample journal at /demo and the methodology page — enough
# to see what Hindsight is. Each block below unlocks one more feature, and the
# server prints which are available on startup.
#
# A variable that is PRESENT but MALFORMED still fails hard: missing means
# "feature off", wrong means "somebody typed this incorrectly".

# --- Database: unlocks accounts, journals, everything personal ----------
# MongoDB Atlas M0 (free) connection string, including the database name.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/hindsight?retryWrites=true&w=majority"

# --- Sessions: with the database above, unlocks sign-in -----------------
# 32+ random bytes. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The origin the app is served from. No trailing slash. On Vercel this is
# derived automatically when unset.
BETTER_AUTH_URL="http://localhost:3000"

# --- OAuth --------------------------------------------------------------
# Google Cloud Console > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub > Settings > Developer settings > OAuth Apps.
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
# Turn OFF wildcard matching on each callback URL.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Scheduled resurfacing: unlocks the review job -----------------------
# Shared secret the review job presents to POST /api/jobs/resurface.
# Generate with:  openssl rand -hex 32
CRON_SECRET=""

# --- Email --------------------------------------------------------------
# "log" prints notifications to stdout and sends nothing. Used in development,
# tests and CI. "brevo" and "smtp2go" send for real — pick one.
EMAIL_MODE="log"
BREVO_API_KEY=""
SMTP2GO_API_KEY=""
# Must be an address verified with whichever provider is in use. Free-tier
# senders are rewritten to a provider-owned address; see
# docs/adr/0005-email-provider.md.
EMAIL_FROM="hindsight@example.com"
EMAIL_REPLY_TO="hindsight@example.com"

# --- Test-only ----------------------------------------------------------
# Enables an email+password sign-in path for end-to-end tests. Ignored in
# production regardless of value; see src/lib/auth/test-mode.ts.
AUTH_TEST_MODE=""

# Copy to `.env.local` for development. Never commit a filled-in copy.
# Every variable here is validated at boot by src/lib/schemas/env.ts; the app
# refuses to start rather than run half-configured.

# --- Database -----------------------------------------------------------
# MongoDB Atlas M0 (free) connection string, including the database name.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/hindsight?retryWrites=true&w=majority"

# --- Sessions -----------------------------------------------------------
# 32+ random bytes. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The origin the app is served from. No trailing slash.
BETTER_AUTH_URL="http://localhost:3000"

# --- OAuth --------------------------------------------------------------
# Google Cloud Console > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub > Settings > Developer settings > OAuth Apps.
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
# Turn OFF wildcard matching on each callback URL.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Scheduled resurfacing ----------------------------------------------
# Shared secret the review job presents to POST /api/jobs/resurface.
# Generate with:  openssl rand -hex 32
CRON_SECRET=""

# --- Email --------------------------------------------------------------
# "log" prints notifications to stdout and sends nothing. Used in development,
# tests and CI. "brevo" sends for real.
EMAIL_MODE="log"
BREVO_API_KEY=""
# Must be an address verified in Brevo. Free-tier senders are rewritten by
# Brevo to an @…brevosend.com address; see docs/adr/0005-email-provider.md.
EMAIL_FROM="hindsight@example.com"
EMAIL_REPLY_TO="hindsight@example.com"

# --- Test-only ----------------------------------------------------------
# Enables an email+password sign-in path for end-to-end tests. Ignored in
# production regardless of value; see src/lib/auth/test-mode.ts.
AUTH_TEST_MODE=""

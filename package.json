{
  "name": "hindsight",
  "version": "0.1.0",
  "private": true,
  "description": "A private decision journal that measures the quality of your judgment over time.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imSuvro/hindsight.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:setup": "tsx scripts/db-setup.ts",
    "prepare": "husky"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.15",
      "downloadDir": "./.cache/mongodb-binaries",
      "disablePostinstall": "1"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml,mjs}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "better-auth": "1.7.1",
    "date-fns": "4.4.0",
    "mongodb": "7.6.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.62.1",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fast-check": "4.9.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "mongodb-memory-server": "11.2.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.16.0"
}
